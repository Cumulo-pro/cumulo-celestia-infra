    "label": "Network",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "query": "label_values(fibre_validator_info, chain)",
    "definition": "label_values(fibre_validator_info, chain)",
    "regex": "",
    "refresh": 1,
    "sort": 1,
    "hide": 0,
    "multi": false,
    "includeAll": false,
    "current": {},
    "options": []
   },
   {
    "type": "query",
    "name": "valcons",
    "label": "Validator",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "query": "query_result(fibre_validator_info{chain=\"$chain\"})",
    "definition": "query_result(fibre_validator_info{chain=\"$chain\"})",
    "regex": "/moniker=\"(?<text>[^\"]*)\".*valcons=\"(?<value>[^\"]+)\"/",
    "refresh": 1,
    "sort": 1,
    "hide": 0,
    "multi": false,
    "includeAll": false,
