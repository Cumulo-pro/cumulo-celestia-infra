# Install (as the user that owns ~/fibre-telegram-bot):
#   sed -e "s|__HOME__|$HOME|g" -e "s|__USER__|$USER|g" deploy/fibre-telegram-bot.service \
#     | sudo tee /etc/systemd/system/fibre-telegram-bot.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now fibre-telegram-bot
[Unit]
Description=Fibre Telegram bot (Cumulo)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/fibre-telegram-bot
EnvironmentFile=__HOME__/fibre-telegram-bot/.env
ExecStart=__HOME__/fibre-telegram-bot/.venv/bin/fibre-bot
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
