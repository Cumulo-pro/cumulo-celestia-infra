# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=

# Fibre Network Monitor API
FIBRE_API_BASE=https://fibre-api.cumulo.com.es
# Chains come from the API (/v1/chains); a chain starts when it says fibre_active true.
# Default network for users (mainnet). Until it is active, the bot uses mocha-5.
DEFAULT_CHAIN=celestia
# Chain of v0.1: buttons sent by v0.1 open it; also used if the chain list cannot be read.
FIBRE_CHAIN=mocha-5
# Limit the bot to some chains (comma separated API keys). Empty = every chain.
FIBRE_CHAINS=
# General public page per chain (key=url, comma separated). No page = no link.
CHAIN_PAGES=mocha-5=https://cumulo.pro/services/celestia_mocha/fibre.php,celestia=https://cumulo.pro/services/celestia/fibre.php
# Report tab per chain (takes ?period= and ?validator=), for card and validator links.
# Add mainnet here only once its report page is confirmed.
CHAIN_REPORT_PAGES=mocha-5=https://cumulo.pro/services/celestia_mocha/fibre-report

# Validator offered by default (Cumulo). Each chain has its own valcons:
# DEFAULT_VALCONS applies to FIBRE_CHAIN; other chains use DEFAULT_VALIDATORS (key=valcons)
# or, if missing, the validator whose moniker is DEFAULT_MONIKER.
DEFAULT_VALCONS=celestiavalcons14s4fvynqhq8u3rwmnef0r22hut6avrtylz0pfx
DEFAULT_VALIDATORS=
DEFAULT_MONIKER=Cumulo

# Your Telegram user id (send /id to the bot). Comma separated for several admins.
# Admins can use /weekly. The first one is also used as image storage when
# STORAGE_CHAT_ID is empty (uploads are deleted right away).
ADMIN_CHAT_IDS=

# Weekly report: leave REPORT_CHANNEL_ID empty to keep it off.
# Add the bot as admin of the channel; its id appears in the log as bot_membership chat_id=...
REPORT_CHANNEL_ID=
WEEKLY_DAY=mon
WEEKLY_TIME=09:00
# Chains included in the weekly post (comma separated API keys). Empty = every chain.
WEEKLY_CHAINS=
TZ=Europe/Madrid

# Optional: a private channel (bot as admin) where card images are uploaded once
# so inline mode can show them. Empty = use the first ADMIN_CHAT_IDS entry.
STORAGE_CHAT_ID=

STATE_PATH=fibre_bot_state.json
POLL_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
